# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here

# Admin Telegram User IDs (comma-separated)
ADMIN_IDS=123456789,987654321

# Database
DATABASE_URL=sqlite+aiosqlite:///vardenproxy.db

# Auto-approve payments (true/false)
AUTO_APPROVE=false

# SOCKS5 Proxy (for routing bot traffic)
PROXY_HOST=127.0.0.1
PROXY_PORT=1080
PROXY_USER=myuser
PROXY_PASS=mypassword
