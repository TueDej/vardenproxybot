# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here

# Admin Telegram User IDs (comma-separated)
ADMIN_IDS=123456789,987654321

# Database
DATABASE_URL=sqlite+aiosqlite:///vardenproxy.db

# Auto-approve payments (true/false) — only used in mock/manual mode
AUTO_APPROVE=false

# Zarinpal payment gateway (leave ACCESS_TOKEN empty to use mock payments)
# ZARINPAL_ACCESS_TOKEN is the 36-char merchant/terminal UUID from your panel
ZARINPAL_ACCESS_TOKEN=
ZARINPAL_CALLBACK_URL=https://pay.example.ir/zarinpal/callback
ZARINPAL_SANDBOX=false
# Internal listener (behind the reverse proxy) — keep bound to loopback
ZARINPAL_BIND_HOST=127.0.0.1
ZARINPAL_BIND_PORT=8099

# SOCKS5 Proxy (for routing bot traffic)
PROXY_HOST=127.0.0.1
PROXY_PORT=1080
PROXY_USER=myuser
PROXY_PASS=mypassword

# 3x-ui Panel (v3.x REST API)
PANEL_URL=https://your-panel-host:2053/webBasePath
PANEL_API_TOKEN=your_api_token_from_settings_security
XUI_INBOUND_ID=1
VPN_LIMIT_IP=2
# Set false if the panel uses a self-signed certificate
PANEL_VERIFY_SSL=true
# Config links sent to users are rewritten to enter through the public
# reverse proxy (TLS on port 443); subscription URLs are never shown.
