# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here

# Admin Telegram User IDs (comma-separated)
ADMIN_IDS=123456789,987654321

# Database
DATABASE_URL=sqlite+aiosqlite:///vardenproxy.db

# Auto-approve payments (true/false)
AUTO_APPROVE=false

# SOCKS5 Proxy (for routing bot traffic)
PROXY_HOST=127.0.0.1
PROXY_PORT=1080
PROXY_USER=myuser
PROXY_PASS=mypassword

# 3x-ui Panel (v3.x REST API)
PANEL_URL=https://your-panel-host:2053/webBasePath
PANEL_API_TOKEN=your_api_token_from_settings_security
XUI_INBOUND_ID=1
VPN_LIMIT_IP=2
# Set false if the panel uses a self-signed certificate
PANEL_VERIFY_SSL=true
# Subscription host is the same as panel but on its own port; leave empty to omit sub links
SUBSCRIPTION_BASE_URL=https://your-panel-host:2096
